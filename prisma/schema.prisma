datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id        String     @id @default(uuid())
  nome      String
  email     String     @unique
  senha     String
  createdAt DateTime   @default(now())
  clientes  Cliente[]
  processos Processo[]
}

model Cliente {
  id         String     @id @default(uuid())
  nome       String
  documento  String     @unique
  email      String?
  advogadoId String
  advogado   Usuario    @relation(fields: [advogadoId], references: [id], onDelete: Cascade)
  processos  Processo[]
}

enum StatusProcesso {
  INICIAL
  INSTRUCAO
  EXECUCAO
  RECURSO
  CONCLUIDO
}

model Processo {
  id          String         @id @default(uuid())
  numero      String         @unique
  titulo      String
  status      StatusProcesso @default(INICIAL)
  valorCausa  Float
  porcentagem Float
  advogadoId  String
  advogado    Usuario        @relation(fields: [advogadoId], references: [id], onDelete: Cascade)
  clienteId   String
  cliente     Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  financeiro  Financeiro[]
  createdAt   DateTime       @default(now())
}

enum TipoTransacao {
  ENTRADA
  SAIDA
}

model Financeiro {
  id          String        @id @default(uuid())
  descricao   String
  valor       Float
  tipo        TipoTransacao
  pago        Boolean       @default(false)
  dataVenc    DateTime
  processoId  String?
  processo    Processo?     @relation(fields: [processoId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
}